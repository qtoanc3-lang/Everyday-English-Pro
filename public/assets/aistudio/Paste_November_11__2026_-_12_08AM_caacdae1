        const normalizedPos = rawPos.endsWith(".") ? rawPos : `${rawPos}.`;
        return {
          ...item,
          unit: normalizedUnit,
          pos: normalizedPos,
          srsLevel: item.srsLevel !== undefined ? item.srsLevel : 0,
          mistakeCount: item.mistakeCount !== undefined ? item.mistakeCount : 0
        };
