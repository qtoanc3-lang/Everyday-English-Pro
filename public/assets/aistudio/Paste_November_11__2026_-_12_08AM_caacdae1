          const arr = (Array.isArray(parsed) ? parsed : (parsed.vocab || [])).map(normalizeImportedItem);
          const existingMap = new Map(vocabList.map((v, idx) => [v.id, idx]));
          let added = 0, updated = 0;
          arr.forEach(item => {
            if (item && item.word) {
              if (item.id && existingMap.has(item.id)) {
                const idx = existingMap.get(item.id);
                const prev = vocabList[idx];
                vocabList[idx] = {
                  ...item,
                  srsLevel: prev.srsLevel !== undefined ? prev.srsLevel : item.srsLevel,
                  mistakeCount: prev.mistakeCount !== undefined ? prev.mistakeCount : item.mistakeCount
                };
                if (item.unit) selectedUnits.add(item.unit);
                updated++;
              } else {
                vocabList.push(item);
                if (item.id) existingMap.set(item.id, vocabList.length - 1);
                if (item.unit) selectedUnits.add(item.unit);
                added++;
              }
            }
          });
          saveDatabase(); syncAllViews(); document.getElementById("jsonModal").classList.add("hidden"); showToast(`Đã hợp nhất ${added} câu mới${updated > 0 ? ` & cập nhật ${updated} câu` : ""}!`);
