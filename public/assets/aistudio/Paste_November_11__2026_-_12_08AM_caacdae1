  "relatedTerms": ["2 cụm từ giao tiếp tương đương"]
}`;
            const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${m}:generateContent?key=${apiKey}`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ contents: [{ parts: [{ text: aiPrompt }] }] })
            });
            const data = await res.json();
            let rawText = data?.candidates?.[0]?.content?.parts?.[0]?.text || "";
            rawText = rawText.replace(/```json/gi, "").replace(/```/g, "").trim();
            if (rawText) {
              const parsed = JSON.parse(rawText);
              if (parsed.meaning && parsed.ipa) {
                return {
                  id: "custom_" + Date.now() + "_" + Math.random().toString(36).slice(2, 6),
                  unit: unit || "Unit 5",
                  word: cleanW,
                  ipa: parsed.ipa || `/${lowerW}/`,
                  pos: parsed.pos || "phr.",
                  meaning: parsed.meaning,
                  relatedTerms: Array.isArray(parsed.relatedTerms) ? parsed.relatedTerms : ["Daily conversation"],
                  example: parsed.example || `In daily conversation, people often say "${cleanW}".`,
                  exampleVi: parsed.exampleVi || `Trong giao tiếp hàng ngày, mọi người thường nói "${parsed.meaning}".`,
                  clinicalNote: parsed.clinicalNote || `Mẫu câu giao tiếp tự nhiên (Được làm giàu bởi Gemini AI).`,
                  dialoguePrompt: parsed.dialoguePrompt || `How would you respond in a situation where you want to say "${parsed.meaning}"?`,
                  dialoguePromptVi: parsed.dialoguePromptVi || `Tình huống giao tiếp cần phản hồi: "${parsed.meaning}"`,
                  srsLevel: 0,
