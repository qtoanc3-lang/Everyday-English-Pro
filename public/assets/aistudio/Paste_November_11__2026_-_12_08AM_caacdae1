          let btnCls = "p-3.5 rounded-xl border text-left text-xs sm:text-sm font-semibold transition flex items-center justify-between ";

          if (userChoice !== undefined) {
            if (optIdx === q.correctIndex) {
              btnCls += "bg-emerald-100 dark:bg-emerald-950/80 border-emerald-500 text-emerald-900 dark:text-emerald-200";
