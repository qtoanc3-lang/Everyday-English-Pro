      const detectedMeaning = meaning ? meaning.trim() : `Mẫu câu: ${cleanW}`;
      return {
        id: "custom_" + Date.now() + "_" + Math.random().toString(36).slice(2, 6),
        unit: unit || "Unit 5",
        word: cleanW,
        ipa: `/${lowerW}/`,
        pos: cleanW.includes(" ") ? "phr." : "n.",
        meaning: detectedMeaning,
        relatedTerms: ["Daily expression"],
        example: `In everyday conversation, native speakers often use "${cleanW}" to express themselves naturally.`,
        exampleVi: `Trong giao tiếp hàng ngày, người bản xứ thường dùng "${cleanW}" (${detectedMeaning}) để diễn đạt tự nhiên.`,
        clinicalNote: `Mẫu câu thuộc ${unit || "Unit 5"}. Hãy luyện phát âm nối âm và phản xạ trong 2 giây.`,
        dialoguePrompt: `Someone talks to you in a daily conversation where you want to reply: "${detectedMeaning}".`,
