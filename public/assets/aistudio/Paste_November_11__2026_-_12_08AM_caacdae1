    function renderSpecialtyList() {
      const box = document.getElementById("specialtyListContainer");
      if (!box) return;
      box.innerHTML = "";
      Object.values(specialtiesMap).forEach(spec => {
        const isCurrent = spec.id === currentSpecialtyId;
        const isDefault = spec.id === "comm_eng";
        const div = document.createElement("div");
        div.className = `p-3 rounded-2xl border flex items-center justify-between gap-2 ${isCurrent ? "bg-indigo-50 dark:bg-indigo-950/60 border-indigo-500" : "bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-700"}`;

        let actionButtons = `<button type="button" data-switch-spec="${spec.id}" class="px-3 py-1.5 rounded-xl text-xs font-bold ${isCurrent ? "bg-indigo-600 text-white" : "bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 hover:bg-indigo-100"}">${isCurrent ? "Đang chọn" : "Chuyển sang"}</button>`;
        if (!isDefault) {
          actionButtons += `<button type="button" data-delete-spec="${spec.id}" class="w-8 h-8 rounded-xl bg-rose-50 text-rose-600 ml-1 flex items-center justify-center shrink-0"><i class="fa-solid fa-trash-can text-xs"></i></button>`;
        }

        div.innerHTML = `
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-indigo-600 text-white flex items-center justify-center"><i class="fa-solid ${spec.icon || "fa-comments"}"></i></div>
            <div><p class="text-xs font-extrabold">${escapeHtml(spec.name)}</p><p class="text-[11px] text-slate-500">${(spec.vocab || []).length} mẫu câu</p></div>
          </div>
          <div class="flex items-center">${actionButtons}</div>
        `;
        box.appendChild(div);
      });

      box.querySelectorAll("[data-switch-spec]").forEach(btn => btn.onclick = () => {
        const specId = btn.getAttribute("data-switch-spec");
        loadSpecialtyState(specId, true);
        document.getElementById("specialtyModal").classList.add("hidden");
        showToast(`Đã chuyển sang: ${specialtiesMap[specId].name}`);
      });
      box.querySelectorAll("[data-delete-spec]").forEach(btn => btn.onclick = () => {
        const specId = btn.getAttribute("data-delete-spec");
        if (confirm(`Xóa chủ đề ${specialtiesMap[specId].name}?`)) {
          delete specialtiesMap[specId];
          localStorage.setItem(STORAGE_KEY_SPECIALTIES, JSON.stringify(specialtiesMap));
          if (currentSpecialtyId === specId) loadSpecialtyState("comm_eng", true);
          else renderSpecialtyList();
        }
      });
    }

    function loadSpecialtyState(specId, resetProgress = true) {
      currentSpecialtyId = specId;
      localStorage.setItem(STORAGE_KEY_CURRENT_SPEC, specId);
      const spec = specialtiesMap[specId];
      vocabList = spec.vocab || [];
      document.getElementById("currentSpecialtyName").textContent = spec.name;
      document.getElementById("headerSpecIcon").className = `fa-solid ${spec.icon || "fa-comments"} text-lg`;

      if (resetProgress) {
        selectedUnits = new Set(getAllUnits());
        onlyMistakesFilter = false;
        document.getElementById("chkOnlyMistakes").checked = false;
        quizIndex = 0; quizScore = 0; fcIndex = 0; dictIndex = 0; quizPool = []; dictPool = [];
      }
      syncAllViews();
      renderSpecialtyList();
    }

