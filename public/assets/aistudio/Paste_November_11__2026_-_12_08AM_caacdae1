    async function queryThreeTierAi(promptText) {
      const sysPrompt = "Bạn là Trợ lý Tiếng Anh Giao Tiếp & Phản Xạ chuyên nghiệp (Everyday English Pro — Tác giả: Quốc Toản). Hãy giải thích chuẩn xác, tự nhiên, phân tích rõ sắc thái giao tiếp (thân mật hay lịch sự), ngữ cảnh sử dụng và đưa ra ví dụ hội thoại A - B thực tế dễ nhớ.";

      // TẦNG 1: Chrome On-Device AI
      if (window.ai && window.ai.languageModel) {
        try {
          const cap = await window.ai.languageModel.capabilities();
          if (cap.available === "readily") {
            const session = await window.ai.languageModel.create({ systemPrompt: sysPrompt });
            const reply = await session.prompt(promptText);
            if (reply) return `📱 [Chrome On-Device AI — Trực tiếp trên thiết bị]\n\n${reply}`;
          }
        } catch (e) {}
      }

      // TẦNG 2: Google Gemini Cloud AI
      const apiKey = localStorage.getItem(STORAGE_KEY_AI_KEY);
      let apiErrorMessage = "";
      if (apiKey) {
        const models = ["gemini-2.5-flash", "gemini-2.0-flash", "gemini-1.5-flash-latest"];
        for (const m of models) {
          try {
            const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${m}:generateContent?key=${apiKey}`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                contents: [{ parts: [{ text: `${sysPrompt}\n\n${promptText}` }] }]
              })
            });
            const data = await res.json();
            if (data?.candidates?.[0]?.content?.parts?.[0]?.text) {
              return `✨ [Google Gemini Cloud AI — Model: ${m}]\n\n${data.candidates[0].content.parts[0].text}`;
            } else if (data?.error?.message) {
              apiErrorMessage = data.error.message;
            }
          } catch (e) {
            apiErrorMessage = e.message || "Lỗi kết nối mạng";
          }
        }
      }

      // TẦNG 3: Phân tích Ngữ cảnh Giao tiếp Nội tuyến (Chế độ Offline)
      const offlineResult = buildOfflineCommAnalysis(promptText);
      if (apiKey && apiErrorMessage) {
        return `⚠️ [CẢNH BÁO GEMINI API KEY]: Không thể kết nối Gemini (${apiErrorMessage}).\n\n👉 Hệ thống tự động chuyển sang Cẩm nang Giao tiếp Nội tuyến (Offline):\n\n${offlineResult}`;
      } else if (!apiKey) {
        return `📚 [Cẩm Nang Giao Tiếp Nội Tuyến — Chế Độ Offline]\n\n${offlineResult}\n\n💡 Mẹo: Nhấn vào "⚙️ Cài đặt Gemini API Key cá nhân" bên dưới để kết nối trực tiếp với Google Gemini 2.5 Flash!`;
      }
      return offlineResult;
    }

    function buildOfflineCommAnalysis(q) {
      const lower = (q || "").toLowerCase().trim();
      const matchedWords = vocabList.filter(v => {
        const wVars = extractAllVariants(v.word);
        const mVars = extractAllVariants(v.meaning);
        return wVars.some(cw => cw.length >= 2 && lower.includes(cw)) ||
               mVars.some(cm => cm.length >= 2 && (lower.includes(cm) || cm.includes(lower)));
      });
      if (matchedWords.length >= 2) {
        const w1 = matchedWords[0], w2 = matchedWords[1];
        return `💬 PHÂN TÍCH SO SÁNH SẮC THÁI GIAO TIẾP:\n\n1️⃣ ${w1.word} (${w1.ipa}): ${w1.meaning}\n   • Sắc thái: ${w1.clinicalNote}\n   • Ví dụ: "${w1.example}"\n\n2️⃣ ${w2.word} (${w2.ipa}): ${w2.meaning}\n   • Sắc thái: ${w2.clinicalNote}\n   • Ví dụ: "${w2.example}"`;
      }
      if (matchedWords.length === 1) {
        const w = matchedWords[0];
        return `💬 HỒ SƠ MẪU CÂU GIAO TIẾP:\n\n• Mẫu câu: ${w.word} (${w.ipa}) — ${w.pos}\n• Nghĩa: ${w.meaning}\n• Ngữ cảnh & Sắc thái: ${w.clinicalNote}\n• Tình huống A nói: "${w.dialoguePrompt || w.example}"\n• Ví dụ: "${w.example}" (${w.exampleVi})`;
      }
      const matchedLex = COMM_EXPRESSION_LEXICON.filter(r => lower.includes(r.aff));
      if (matchedLex.length > 0) {
        return `🧩 GIẢI MÃ CỤM PHẢN XẠ GIAO TIẾP:\n\n` + matchedLex.map(r => `• ${r.type}: ${r.mean}\n  ➔ Ngữ cảnh: ${r.note}`).join("\n\n");
      }
      return `📚 DỮ LIỆU NỘI TUYẾN:\nHãy thử bấm vào các gợi ý phía trên hoặc nhập một từ/cụm câu có trong 8 Unit giao tiếp. Bạn cũng có thể lưu Gemini API Key bên dưới để AI giải thích tự do mọi tình huống.`;
    }

